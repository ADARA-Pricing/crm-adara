# Database / Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=crm"

# Botpress server-side secrets: never expose these values in browser code
BOTPRESS_WEBHOOK_SECRET="replace-with-a-random-secret"
BOTPRESS_BOT_ID=""
BOTPRESS_API_TOKEN=""
BOTPRESS_WORKSPACE_ID=""

# Meta Marketing API (server-side only; do not expose any of these with NEXT_PUBLIC_)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://your-crm.example.com/api/meta/callback"
# 32 random bytes encoded as base64, for example: openssl rand -base64 32
META_TOKEN_ENCRYPTION_KEY=""
# Account ID without the act_ prefix. Leave empty only if you intentionally want to choose it later.
META_AD_ACCOUNT_ID="349568442368598"
# Update deliberately after checking Meta's supported Marketing API versions.
META_GRAPH_API_VERSION="v25.0"
