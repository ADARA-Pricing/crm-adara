generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum FunnelStage {
  FIRST_CONTACT
  INTERESTED
  VERY_INTERESTED
  COORDINATE_DELIVERY
  LOCAL_PICKUP
  COMPLETED
  ABANDONED
}

enum OrderStatus {
  DRAFT
  AWAITING_CUSTOMER_CONFIRMATION
  PENDING_REVIEW
  APPROVED_FOR_LOGISTICS
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ConversationStatus {
  OPEN
  HUMAN_HANDOFF
  CLOSED
}

model Customer {
  id              String           @id @default(cuid())
  whatsappId      String?          @unique
  phone           String?          @unique
  fullName        String?
  email           String?          @unique
  status          CustomerStatus   @default(LEAD)
  funnelStage     FunnelStage      @default(FIRST_CONTACT)
  funnelNote      String?
  funnelUpdatedAt DateTime         @default(now())
  deliveryPreference String?
  locality        String?
  deliveryAddress String?
  postalCode      String?
  requestedDate   DateTime?
  lastMessagePreview String?
  lastMessageAt   DateTime?
  notes           String?
  conversations   Conversation[]
  orders          Order[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Product {
  id              String           @id @default(cuid())
  sku             String           @unique
  name            String
  description     String?
  shortDescription String?
  botDescription  String?
  category        String?
  priceCents      Int
  shippingCents   Int              @default(0)
  costCents       Int?
  currency        String           @default("ARS")
  stock           Int              @default(0)
  isActive        Boolean          @default(true)
  isAvailableForBot Boolean        @default(false)
  warrantyMonths  Int              @default(12)
  technicalSpecs  Json?
  imageUrls       String[]         @default([])
  includedItems   String[]         @default([])
  orderItems      OrderItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Order {
  id              String           @id @default(cuid())
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  status          OrderStatus      @default(DRAFT)
  deliveryMethod  String
  paymentMethod   String
  recipientName   String
  deliveryAddress String
  postalCode      String?
  locality        String
  requestedDate   DateTime?
  shippingCents   Int              @default(0)
  riskReview      Boolean          @default(false)
  reviewReason    String?
  reviewedAt      DateTime?
  assignedCourier String?
  deliveryTimeWindow String?
  logisticsNote   String?
  deliveredAt     DateTime?
  totalCents      Int              @default(0)
  currency        String           @default("ARS")
  source          String           @default("whatsapp")
  items           OrderItem[]
  activities      OrderActivity[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model OrderActivity {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action          String
  detail          String?
  createdAt       DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id              String           @id @default(cuid())
  orderId         String
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product          @relation(fields: [productId], references: [id])
  quantity        Int
  unitPriceCents  Int
}

model Conversation {
  id              String             @id @default(cuid())
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id])
  botpressId      String?            @unique
  channel         String             @default("whatsapp")
  status          ConversationStatus @default(OPEN)
  summary         String?
  events          ConversationEvent[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model ConversationEvent {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction       String
  type            String
  payload         Json
  createdAt       DateTime     @default(now())
}
