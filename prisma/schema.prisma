generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum FunnelStage {
  FIRST_CONTACT
  INTERESTED
  VERY_INTERESTED
  COORDINATE_DELIVERY
  LOCAL_PICKUP
  COMPLETED
  ABANDONED
}

enum OrderStatus {
  DRAFT
  AWAITING_CUSTOMER_CONFIRMATION
  PENDING_REVIEW
  APPROVED_FOR_LOGISTICS
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ConversationStatus {
  OPEN
  HUMAN_HANDOFF
  CLOSED
}

enum UserRole {
  ADMIN
  SALES
  LOGISTICS
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskType {
  FOLLOW_UP
  DELIVERY_CONFIRMATION
  ORDER_REVIEW
  LOGISTICS
  OTHER
}

model UserProfile {
  id          String   @id
  email       String   @unique
  displayName String?
  role        UserRole @default(SALES)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignedTasks Task[] @relation("TaskAssignee")
}

model Customer {
  id              String           @id @default(cuid())
  whatsappId      String?          @unique
  phone           String?          @unique
  fullName        String?
  email           String?          @unique
  status          CustomerStatus   @default(LEAD)
  funnelStage     FunnelStage      @default(FIRST_CONTACT)
  funnelNote      String?
  funnelUpdatedAt DateTime         @default(now())
  deliveryPreference String?
  locality        String?
  deliveryAddress String?
  postalCode      String?
  requestedDate   DateTime?
  lastMessagePreview String?
  lastMessageAt   DateTime?
  notes           String?
  conversations   Conversation[]
  orders          Order[]
  attributions    AcquisitionAttribution[]
  tasks           Task[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Product {
  id              String           @id @default(cuid())
  sku             String           @unique
  name            String
  description     String?
  shortDescription String?
  botDescription  String?
  category        String?
  priceCents      Int
  shippingCents   Int              @default(0)
  costCents       Int?
  currency        String           @default("ARS")
  stock           Int              @default(0)
  isActive        Boolean          @default(true)
  isAvailableForBot Boolean        @default(false)
  warrantyMonths  Int              @default(12)
  technicalSpecs  Json?
  imageUrls       String[]         @default([])
  includedItems   String[]         @default([])
  orderItems      OrderItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model DeliveryCoverageZone {
  id              String   @id @default(cuid())
  provider        String   @default("mercadolibre_flex")
  providerZoneId  String   @unique
  name            String
  normalizedName  String   @unique
  weekCutoffHour  Int?
  isActive        Boolean  @default(true)
  sourceUpdatedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, normalizedName])
}

model Order {
  id              String           @id @default(cuid())
  saleNumber      Int              @unique @default(autoincrement())
  saleDate        DateTime         @default(now())
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  status          OrderStatus      @default(DRAFT)
  deliveryMethod  String
  paymentMethod   String
  recipientName   String
  deliveryAddress String
  postalCode      String?
  locality        String
  requestedDate   DateTime?
  deliveryDate    DateTime?
  shippingCents   Int              @default(0)
  riskReview      Boolean          @default(false)
  reviewReason    String?
  reviewedAt      DateTime?
  assignedCourier String?
  deliveryTimeWindow String?
  logisticsNote   String?
  deliveredAt     DateTime?
  totalCents      Int              @default(0)
  currency        String           @default("ARS")
  source          String           @default("whatsapp")
  attributionId   String?
  attribution     AcquisitionAttribution? @relation(fields: [attributionId], references: [id])
  items           OrderItem[]
  activities      OrderActivity[]
  tasks           Task[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        TaskType   @default(OTHER)
  status      TaskStatus @default(OPEN)
  dueAt       DateTime?
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    UserProfile? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, dueAt])
  @@index([assigneeId, status])
}

model AcquisitionAttribution {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  source          String?
  referrer        String?
  utmSource       String?
  utmCampaign     String?
  utmContent      String?
  campaignId      String?
  campaignName    String?
  adsetId         String?
  adsetName       String?
  adId            String?
  adName          String?
  capturedAt      DateTime @default(now())
  orders          Order[]

  @@index([customerId, capturedAt])
  @@index([campaignId])
  @@index([adsetId])
  @@index([adId])
}

model OrderActivity {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action          String
  detail          String?
  createdAt       DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id              String           @id @default(cuid())
  orderId         String
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product          @relation(fields: [productId], references: [id])
  quantity        Int
  unitPriceCents  Int
}

model Conversation {
  id              String             @id @default(cuid())
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id])
  botpressId      String?            @unique
  channel         String             @default("whatsapp")
  status          ConversationStatus @default(OPEN)
  summary         String?
  events          ConversationEvent[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model ConversationEvent {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction       String
  type            String
  payload         Json
  createdAt       DateTime     @default(now())
}
